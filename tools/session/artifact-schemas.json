{
  "version": "2.0.0",
  "description": "Required Markdown/HTML section headings for session lifecycle artifacts. validate_artifacts.py enforces these when a file is present. Follows SemVer 2.0.0 (https://semver.org/).",
  "artifacts": {
    "QUICK": {
      "required_headings": [
        "Goal",
        "Out of scope"
      ],
      "content_rules": {
        "goal_not_activity": true,
        "max_task_cards": 3
      }
    },
    "DISCUSSION": {
      "required_headings": [
        "Step ledger",
        "Executive summary",
        "Developer overview",
        "Keywords",
        "Spec quality review",
        "Goal",
        "Recommendation"
      ],
      "content_rules": {
        "goal_not_activity": true
      }
    },
    "BUSINESS_ANALYSIS": {
      "required_headings": [
        "Step ledger",
        "Executive summary",
        "Developer overview",
        "Spec quality review",
        "User stories",
        "Acceptance criteria",
        "Handoff"
      ]
    },
